FROM registry.access.redhat.com/ubi10/go-toolset@sha256:0a1242b10a483946adcf3e35e18f5a19996869468f73deff2c5ce451ce0fa6bc AS builder
USER 0
WORKDIR /src
COPY showroom-content/main.go .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/content-loader main.go

FROM scratch
COPY --from=builder --chown=1001:0 /out/content-loader /content-loader
COPY --chown=1001:0 showroom /bundle/showroom
USER 1001
ENTRYPOINT ["/content-loader"]
