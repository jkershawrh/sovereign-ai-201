{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.redhat-intel.com/sovereign-ai-201/governed-request.schema.json",
  "title": "Governed inference request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "correlation_id", "identity", "residency", "data_classification", "requested_model", "prompt", "final_decision_owner"],
  "properties": {
    "contract_version": {"const": "sovereign-inference/v1"},
    "request_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,79}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "trust_domain"],
      "properties": {
        "subject": {"type": "string", "minLength": 3, "maxLength": 160},
        "trust_domain": {"type": "string", "minLength": 3, "maxLength": 120}
      }
    },
    "residency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_origin", "approved_regions", "destination_region"],
      "properties": {
        "data_origin": {"type": "string", "minLength": 2, "maxLength": 64},
        "approved_regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 64}},
        "destination_region": {"type": "string", "minLength": 2, "maxLength": 64}
      }
    },
    "data_classification": {"enum": ["general", "sensitive_personal", "regulated"]},
    "requested_model": {"type": "string", "minLength": 3, "maxLength": 160},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 2000},
    "final_decision_owner": {"type": "string", "minLength": 3, "maxLength": 120}
  }
}

