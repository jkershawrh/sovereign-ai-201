{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.redhat-intel.com/sovereign-ai-201/evidence-record.schema.json",
  "title": "Governed inference evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "request_id", "correlation_id", "collected_at", "source_state", "request_sha256", "identity", "residency", "data_classification", "requested_model", "policy", "outcome", "model_participated", "authority", "secret_values_recorded"],
  "properties": {
    "evidence_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string"},
    "collected_at": {"type": "string", "format": "date-time"},
    "source_state": {"enum": ["LIVE", "REHEARSAL", "OFFLINE"]},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"type": "object"},
    "residency": {"type": "object"},
    "data_classification": {"type": "string"},
    "requested_model": {"type": "string"},
    "policy": {"type": "object"},
    "outcome": {"type": "string"},
    "model_participated": {"type": "boolean"},
    "model_identity": {"type": ["object", "null"]},
    "authority": {"const": "HUMAN_REVIEW_REQUIRED"},
    "secret_values_recorded": {"const": false}
  }
}

